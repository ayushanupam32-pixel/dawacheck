# Copy to .env.local for local development. Never commit .env.local.
#
# Both values are safe to be public: the publishable key can only READ, because every table has
# a read-only Row Level Security policy. They are used only on the server (/api/match).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional cloud OCR fallback. Must stay false for the app's default behaviour.
ENABLE_VISION_FALLBACK=false

# The Supabase SECRET key is NOT listed here on purpose: it lives only in GitHub Actions
# secrets (SUPABASE_URL, SUPABASE_SERVICE_KEY), where the data pipeline uses it.
