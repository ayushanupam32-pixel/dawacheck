# Copy to .env.local for local development. Never commit real values.
# Both values are safe for the browser: the public key can only READ,
# because every table has a read-only Row Level Security policy.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional cloud OCR fallback. Must stay false for the app's default behaviour.
ENABLE_VISION_FALLBACK=false

# The Supabase SERVICE key is NOT listed here on purpose: it lives only in
# GitHub Actions secrets (SUPABASE_URL, SUPABASE_SERVICE_KEY) for the pipeline.
